SERVER_ADDR=http://localhost:5230
BOT_TOKEN=your_bot_token
# Optional Telegram API proxy (not an HTTP CONNECT proxy).
BOT_PROXY_ADDR=
# Shared network proxy for Telegram and AI. Supports http(s)://, socks5://,
# socks5h:// and direct. Empty keeps HTTP_PROXY/HTTPS_PROXY/NO_PROXY behavior.
PROXY_URL=
# Optional Telegram override (also covers file downloads); empty inherits PROXY_URL.
TELEGRAM_PROXY_URL=
ALLOWED_USERNAMES=
# Binary default. Docker Compose uses /data/data.txt in its persistent volume.
DATA=data.txt
