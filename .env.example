# 即时保存模式。必须填写允许用户，不能全部留空。
SERVER_ADDR=http://localhost:5230
# Memos 如受 Cloudflare Access 保护，成对填写 Service Token；否则留空。
MEMOS_CF_ACCESS_CLIENT_ID=
MEMOS_CF_ACCESS_CLIENT_SECRET=
BOT_TOKEN=

# 以下用户名或数字 ID 至少填写一项；多项用英文逗号分隔。
# 用户名可带 @，不区分大小写；数字 ID 不要求账号设置用户名。
ALLOWED_USERNAMES=
ALLOWED_USER_IDS=
# 兼容原有配置，与 ALLOWED_USER_IDS 合并。
TELEGRAM_USER_ID=
# 只有确实需要开放所有人时，手动将上面任意一项单独填为 none。
# 其余允许用户字段必须留空；默认不会取消限制。

# 留空表示使用 Telegram 官方 API；这不是网络代理地址。
BOT_PROXY_ADDR=
# 网络代理支持 http(s)://、socks5://、socks5h:// 和 direct。
# 留空时沿用 HTTP_PROXY / HTTPS_PROXY / NO_PROXY。
PROXY_URL=
# Telegram 专用代理；留空继承 PROXY_URL，direct 强制直连。
TELEGRAM_PROXY_URL=
# 二进制默认保存位置。容器使用 /data/data.txt 并挂载持久卷。
DATA=data.txt
# 留空启用即时保存模式。
NOTEBOOK_CONFIG=
