SERVER_ADDR=http://host.docker.internal:5230
BOT_TOKEN=replace-with-telegram-bot-token
BOT_PROXY_ADDR=
# Shared proxy for Telegram and AI providers. Examples:
# PROXY_URL=http://host.docker.internal:7890
# PROXY_URL=socks5://host.docker.internal:1080
PROXY_URL=
# Telegram-only override; direct bypasses the shared and system proxies.
TELEGRAM_PROXY_URL=
# Optional provider proxy, referenced by proxy_env in notebook.yaml:
# COMPATIBLE_PROXY_URL=socks5://user:password@host.docker.internal:1080
TELEGRAM_USER_ID=replace-with-your-numeric-user-id
MEMOS_TOKEN=replace-with-memos-personal-access-token
NOTEBOOK_CONFIG=notebook.yaml
CLIPROXY_API_KEY=replace-with-your-proxy-key
COMPATIBLE_API_KEY=replace-with-your-other-provider-key
