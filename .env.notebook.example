# AI 笔记模式。先填写真实凭据，以及至少一项允许用户。
SERVER_ADDR=http://host.docker.internal:5230
BOT_TOKEN=
MEMOS_TOKEN=
NOTEBOOK_CONFIG=notebook.yaml

# 网页配置：原生程序默认监听本机；Compose 会覆盖为容器内的 0.0.0.0:8080。
WEB_ADDR=127.0.0.1:8080
# 填写 HTTPS 反向代理地址后，可在机器人发送 /settings 打开网页。
WEB_URL=

# 用户名或数字 ID 至少填写一项；多项用英文逗号分隔。
ALLOWED_USERNAMES=
ALLOWED_USER_IDS=
# 兼容原有单用户配置；也可继续在这里填写 Telegram 数字 ID。
TELEGRAM_USER_ID=
# 只有手动将其中一项单独填写为 none 才开放所有人；其他项须留空。
# 所有获准用户共用上面的 Memos 账号，但素材和草稿按用户隔离。

# 根据 notebook.yaml 里的 key_env 填写对应供应商的密钥。
CLIPROXY_API_KEY=
COMPATIBLE_API_KEY=

# Telegram API 地址通常留空，网络代理使用下面的字段。
BOT_PROXY_ADDR=
PROXY_URL=
TELEGRAM_PROXY_URL=
# 供应商如需独立代理，可在 notebook.yaml 使用 proxy_env 引用：
# COMPATIBLE_PROXY_URL=socks5://user:password@host.docker.internal:1080
